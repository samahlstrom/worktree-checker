    <label class="sr" for="project">Project</label>
    <select id="project" title="Filter by project">
      {project_options}
    </select>
    <div class="search-bar">
      <label class="sr" for="q">Search worktrees</label>
      <input id="q" type="search" placeholder="Search worktree, repo, branch, issue, PR…"
             autocomplete="off" spellcheck="false" autofocus>
    </div>
  </div>
  <div class="table-shell" id="table-shell">
    <table>
      <thead>
        <tr>
          <th>project</th><th>worktree</th><th>branch</th><th>issue</th>
          <th>pr</th><th>pr state</th>
          <th>commit</th><th>status</th><th></th>
        </tr>
      </thead>
      <tbody id="rows">{rows}</tbody>
    </table>
    <p class="empty" id="empty">No worktrees match.</p>
  </div>
