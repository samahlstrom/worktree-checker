#!/usr/bin/env python3
"""bin/board -- one bookmarkable page listing every worktree's dev-server
preview link, across every repo the fleet has ever touched.

Click a stopped row's Start, wait for the poll to catch the dev server
answering, land on the running app. Click a running row's link straight
through, or Stop it. Links only -- no chat box, no shot lists, no
screenshots; those are separate future work.

No CDN, no framework: stdlib http.server plus the small amount of JS the
readiness poll and client-side search need.
"""
import argparse
import hashlib
import html
import http.server
import importlib.machinery
import importlib.util
import json
import os
import re
import socket
import subprocess
import sys
import time
import threading
import urllib.parse

BIN = os.path.dirname(os.path.realpath(__file__))
AVATAR_PATH = os.path.join(os.path.dirname(BIN), "assets", "sam-pixel.png")
PORT = int(os.environ.get("WORKTREE_CHECKER_PORT", "7777"))
LINEAR_ID_RE = re.compile(r"([A-Z]{2,10}-\d+)")

# 90s TTL: gh pr list is ~1.7s per repo and we walk ~14 roots. A 90s window
# keeps a busy refresh cycle (open page, start a server, refresh) free of
# gh calls, while still picking up merges within about a minute and a half.
# 60s would thrash on slow multi-repo loads; 120s is fine but slightly stale
# for "I just merged that" glances. 90 sits in the middle.
PR_CACHE_TTL_S = 90
_PR_CACHE = {}  # full_name -> {expires, by_branch}
_PR_LOCK = threading.Lock()
_PR_FETCHING = set()

# A commit/rebase changes the compiled module graph; Vite HMR handles ordinary
# edits. Wait briefly for Git to settle, then restart only the affected preview.
REVISION_DEBOUNCE_S = 2.0
REVISION_POLL_S = 1.0
_REVISION_PENDING = {}  # worktree path -> (observed HEAD, first-seen monotonic)


def _load(name, filename):
    loader = importlib.machinery.SourceFileLoader(name, os.path.join(BIN, filename))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


repositories = _load("board_repositories", "repositories")
preview = _load("board_preview", "preview")
import merged_pr_cleanup


def clear_pr_cache():
    """Drop the in-process PR list cache (tests; also available for manual refresh)."""
    _PR_CACHE.clear()


def pr_state_label(gh_state):
    """Map GitHub PR state to board labels.

    OPEN -> Open, MERGED -> Merged, CLOSED (not merged) -> Cancelled.
    """
    if not gh_state:
        return ""
    s = str(gh_state).upper()
    if s == "OPEN":
        return "Open"
    if s == "MERGED":
        return "Merged"
    if s == "CLOSED":
        return "Cancelled"
    return ""


def origin_full_name(repo_root):
    """GitHub Owner/repo from the origin remote, or None if missing/non-GitHub."""
    if not repo_root:
        return None
    try:
        r = subprocess.run(
            ["git", "-C", repo_root, "remote", "get-url", "origin"],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return repositories.normalize_github_full_name((r.stdout or "").strip())


def project_identity(repo_root):
    """(owner, project) for filtering.

    GitHub origin -> ("owner", "owner/project"). No remote / non-GitHub
    falls back to ("", basename) so local roots stay filterable.
    Reuses origin_full_name -- no second remote parser.
    """
    full = origin_full_name(repo_root)
    if full and "/" in full:
        owner, _repo = full.split("/", 1)
        return owner, full
    return "", os.path.basename(os.path.realpath(repo_root or "") or "")


def project_filter_options(rows):
    """Build select options from rows present. No hardcoded repo names.

    Returns list of (value, label): 'all', owner:Owner, project:Owner/repo
    (or project:dirname for no-remote roots). Owners and projects are
    individually selectable -- an owner matches its repositories; owner/project
    matches only one.
    """
    owners = set()
    projects = set()
    for r in rows or []:
        owner = (r.get("owner") or "").strip()
        project = (r.get("project") or "").strip()
        if owner:
            owners.add(owner)
        if project:
            projects.add(project)
    opts = [("all", "All projects")]
    for owner in sorted(owners, key=str.lower):
        opts.append((f"owner:{owner}", owner))
    for project in sorted(projects, key=str.lower):
        opts.append((f"project:{project}", project))
    return opts


def row_matches_project(row, selection):
    """True if row matches project filter value (all | owner:X | project:Y)."""
    sel = (selection or "all").strip()
    if not sel or sel == "all":
        return True
    if sel.startswith("owner:"):
        return (row.get("owner") or "") == sel[len("owner:"):]
    if sel.startswith("project:"):
        return (row.get("project") or "") == sel[len("project:"):]
    return True


def row_matches_search(row, needle):
    """True if row's search blob contains needle (empty needle matches all)."""
    n = (needle or "").strip().lower()
    if not n:
        return True
    return n in _search_blob(row)


def _project_options_html(rows):
    parts = []
    for value, label in project_filter_options(rows):
        parts.append(
            f'<option value="{html.escape(value, quote=True)}">'
            f'{html.escape(label)}</option>'
        )
    return "\n".join(parts)


def _default_gh_runner(args, **kwargs):
    return subprocess.run(args, capture_output=True, text=True, timeout=kwargs.get("timeout", 20))


def _run_gh_pr_list(full_name, runner=None):
    """One gh pr list for the repo. Returns list of PR dicts, or [] on any failure."""
    runner = runner or _default_gh_runner
    try:
        r = runner(
            [
                "gh", "pr", "list",
                "--repo", full_name,
                "--state", "all",
                "--limit", "500",
                "--json", "number,headRefName,state,url,title",
            ],
            timeout=20,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if getattr(r, "returncode", 1) != 0:
        return []
    try:
        data = json.loads(r.stdout or "[]")
    except (json.JSONDecodeError, TypeError):
        return []
    return data if isinstance(data, list) else []


def list_prs_for_repo(repo_root, full_name=None, runner=None, now=None):
    """Show Git rows immediately; fill PR details from one background fetch."""
    name = full_name if full_name is not None else origin_full_name(repo_root)
    if not name:
        return {}
    with _PR_LOCK:
        hit = _PR_CACHE.get(name, {'expires': 0, 'by_branch': {}})
        if hit['expires'] <= time.time() and name not in _PR_FETCHING:
            _PR_FETCHING.add(name)
            def refresh():
                try:
                    prs = _run_gh_pr_list(name, runner=runner)
                    by_branch = {pr['headRefName']: pr for pr in prs
                                 if isinstance(pr, dict) and pr.get('headRefName')}
                    with _PR_LOCK:
                        _PR_CACHE[name] = {'expires': time.time() + PR_CACHE_TTL_S,
                                           'by_branch': by_branch}
                finally:
                    with _PR_LOCK:
                        _PR_FETCHING.discard(name)
            threading.Thread(target=refresh, daemon=True).start()
        return hit['by_branch']


def _parse_worktrees(repo_root):
    """List linked worktrees from Git, excluding the primary checkout."""
    r = subprocess.run(["git", "-C", repo_root, "worktree", "list", "--porcelain"],
                       capture_output=True, text=True, timeout=20)
    if r.returncode != 0:
        return []
    entries, cur = [], {}
    for line in r.stdout.splitlines() + [""]:
        if not line:
            if cur.get("path"):
                entries.append(cur)
            cur = {}
        elif line.startswith("worktree "):
            cur["path"] = line[len("worktree "):]
        elif line.startswith("HEAD "):
            cur["head"] = line[len("HEAD "):]
        elif line.startswith("branch "):
            cur["branch"] = line[len("branch "):].replace("refs/heads/", "", 1)
        elif line == "detached":
            cur["branch"] = ""
    return entries[1:]  # git always lists the primary checkout first


def _commit_dates(repo_root, heads):
    """Map head sha -> %cI for a whole repo in one git call.

    With ~150+ linked worktrees, a per-worktree `git log -1` was the next hang
    risk when repeated per worktree. --no-walk resolves each sha
    without walking history.
    """
    unique = [h for h in dict.fromkeys(heads) if h]
    if not unique:
        return {}
    try:
        r = subprocess.run(
            ["git", "-C", repo_root, "log", "--no-walk", "--format=%H\t%cI", *unique],
            capture_output=True, text=True, timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}
    if r.returncode != 0:
        return {}
    out = {}
    for line in (r.stdout or "").splitlines():
        if "\t" not in line:
            continue
        sha, date = line.split("\t", 1)
        out[sha] = date
    return out


def _empty_pr_fields():
    return {
        "pr_number": None,
        "pr_url": "",
        "pr_title": "",
        "pr_state": "",
        "pr_label": "",
    }


def _pr_fields(pr):
    if not pr:
        return _empty_pr_fields()
    state = pr.get("state") or ""
    return {
        "pr_number": pr.get("number"),
        "pr_url": pr.get("url") or "",
        "pr_title": pr.get("title") or "",
        "pr_state": state,
        "pr_label": pr_state_label(state),
    }


def build_rows():
    """One row per linked worktree across every discovered repo, newest commit
    first. Repos with no dev server still appear -- branch, PR,
    and state stay useful even when start is unavailable.

    A worktree is startable only when package.json has scripts.dev. Non-
    startable rows never get a Start button; they keep a reveal affordance
    so the user can open the folder.

    PR data is joined on branch name after one cached `gh pr list` per repo
    (never per worktree). Soft-fail: missing origin / non-GitHub / gh errors
    leave PR cells empty rather than blanking the page.
    """
    rows = []
    prs_by_repo = {}
    identity_by_repo = {}
    for repo_root in repositories.repo_roots():
        entries = [entry for entry in _parse_worktrees(repo_root)
                   if entry.get("path") and os.path.isdir(entry["path"])]
        if not entries:
            continue
        if repo_root not in identity_by_repo:
            identity_by_repo[repo_root] = project_identity(repo_root)
        if repo_root not in prs_by_repo:
            # One gh pr list per repo (cached). Never one call per worktree --
            # that would block the page.
            try:
                prs_by_repo[repo_root] = list_prs_for_repo(repo_root)
            except Exception:
                prs_by_repo[repo_root] = {}
        dates = _commit_dates(repo_root, [e.get("head", "") for e in entries])
        owner, project = identity_by_repo[repo_root]
        for entry in entries:
            path = entry["path"]
            startable = preview.dev_command(path) is not None
            # Non-startable trees never run a preview; skip pid/port IO.
            if startable:
                st = preview.status(path)
                running, port = st["running"], st["port"]
                crashed = bool(st.get("crashed"))
                log_tail = st.get("log_tail") or ""
                status_message = st.get("message") or ""
                served_revision = preview.served_revision(path) if running else ""
            else:
                running, port = False, None
                crashed, log_tail, status_message, served_revision = False, "", "", ""
            branch = entry.get("branch", "")
            m = LINEAR_ID_RE.search(branch)
            pr = prs_by_repo[repo_root].get(branch)
            head = entry.get("head", "")
            row = {
                "name": os.path.basename(path),
                "repo": os.path.basename(repo_root),
                "owner": owner,
                "project": project,
                "branch": branch,
                "issue_id": (f"{project}#{re.search(r'#(\d+)', branch).group(1)}"
                             if re.search(r"#(\d+)", branch) else m.group(1) if m else ""),
                "commit_date": dates.get(head, ""),
                "path": path,
                "running": running,
                "crashed": crashed,
                "log_tail": log_tail,
                "message": status_message,
                "port": port,
                "startable": startable,
                "head": head,
                "served_revision": served_revision,
            }
            row.update(_pr_fields(pr))
            rows.append(row)
    rows.sort(key=lambda r: r["commit_date"], reverse=True)
    # Running worktrees first. Two stable sorts, not one compound key: the date
    # ordering above survives underneath. Among 160 rows the one actually
    # serving is otherwise unfindable, and coming back from the app to stop it
    # is exactly when you need it.
    rows.sort(key=lambda r: not r.get("running"))
    return rows


# Git touches <common-git-dir>/worktrees whenever a linked worktree is added or
# removed, so its mtime is a free "did the set change?" signal. Caching the
# listing behind it is what makes /api/fingerprint cheap enough to poll: the 14
# `git worktree list` subprocesses cost ~0.47s, the stat costs microseconds.
_WORKTREE_LIST_CACHE = {}   # repo_root -> (mtime_ns, [path, ...])
_GIT_COMMON_DIR = {}        # repo_root -> common git dir (never moves)


def _worktrees_admin_dir(repo_root):
    """<common git dir>/worktrees, or None. Resolved once per repo."""
    if repo_root not in _GIT_COMMON_DIR:
        try:
            r = subprocess.run(["git", "-C", repo_root, "rev-parse", "--git-common-dir"],
                               capture_output=True, text=True, timeout=10)
            common = r.stdout.strip() if r.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            common = ""
        if common and not os.path.isabs(common):
            common = os.path.join(repo_root, common)
        _GIT_COMMON_DIR[repo_root] = common
    common = _GIT_COMMON_DIR[repo_root]
    return os.path.join(common, "worktrees") if common else None


def _admin_dir_signature(repo_root):
    """Notice completed adds, moves, branch changes, and removals in Git itself."""
    admin = _worktrees_admin_dir(repo_root)
    if not admin:
        return []
    try:
        entries = sorted(os.listdir(admin))
    except OSError:
        return []
    signature = []
    for entry in entries:
        files = []
        for name in ('gitdir', 'HEAD'):
            try:
                stat = os.stat(os.path.join(admin, entry, name))
                files.append((name, stat.st_mtime_ns, stat.st_size))
            except OSError:
                files.append((name, None, None))
        signature.append((entry, files))
    return signature


def _cached_worktree_paths(repo_root):
    """Linked worktree paths for one repo, re-listed only when git's admin dir
    changed. Falls back to listing every time if the mtime is unreadable."""
    sig = _admin_dir_signature(repo_root)
    hit = _WORKTREE_LIST_CACHE.get(repo_root)
    if hit and hit[0] == sig:
        return hit[1]
    paths = [e.get("path", "") for e in _parse_worktrees(repo_root) if e.get("path")]
    _WORKTREE_LIST_CACHE[repo_root] = (sig, paths)
    return paths


def _cached_repo_roots(now=None):
    # Shallow local directory reads; new repos must not wait for a TTL.
    return list(repositories.repo_roots())


def fingerprint():
    """Local inventory and process state only; never wait for GitHub."""
    parts = []
    for root in _cached_repo_roots():
        parts.append((root, _admin_dir_signature(root)))
        parts.extend((path, os.path.isdir(path), os.path.isfile(os.path.join(path, 'package.json')))
                     for path in _cached_worktree_paths(root))
    state = preview._load_state()
    processes = preview._processes() if state else {}
    parts.append([(path, record, bool(preview._members(record, processes)))
                  for path, record in sorted(state.items())])
    parts.append({name: hit['by_branch'] for name, hit in list(_PR_CACHE.items())})
    return hashlib.sha256(json.dumps(parts, sort_keys=True).encode()).hexdigest()[:16]


def _search_blob(row):
    parts = [
        row.get("name") or "",
        row.get("repo") or "",
        row.get("owner") or "",
        row.get("project") or "",
        row.get("branch") or "",
        row.get("issue_id") or "",
    ]
    if row.get("pr_number") is not None:
        parts.append(str(row["pr_number"]))
        parts.append("#" + str(row["pr_number"]))
    parts.append(row.get("pr_title") or "")
    parts.append(row.get("pr_label") or "")
    parts.append(row.get("pr_state") or "")
    if row.get("startable"):
        parts.append("startable")
    else:
        parts.append("no dev server")
        parts.append("not startable")
    if row.get("crashed"):
        parts.append("crashed")
    return " ".join(parts).lower()


def refresh_running_previews(now=None):
    """Restart a running preview after its worktree HEAD settles."""
    now = time.monotonic() if now is None else now
    for path in preview._load_state():
        if preview.dev_command(path) is None:
            preview.stop(path)
    for repo_root in _cached_repo_roots():
        for path in _cached_worktree_paths(repo_root):
            if not os.path.isdir(path) or preview.dev_command(path) is None:
                continue
            running = preview.status(path)
            current = preview.worktree_revision(path)
            if not running.get("running") or not current or preview.served_revision(path) == current:
                _REVISION_PENDING.pop(path, None)
                continue
            pending = _REVISION_PENDING.get(path)
            if pending is None or pending[0] != current:
                _REVISION_PENDING[path] = (current, now)
                continue
            if now - pending[1] >= REVISION_DEBOUNCE_S:
                result = preview.restart(path, expected_revision=current)
                if result.get("ok"):
                    _REVISION_PENDING.pop(path, None)


def _revision_watcher():
    while True:
        try:
            refresh_running_previews()
        except Exception:
            pass
        time.sleep(REVISION_POLL_S)


def _reveal_path(path):
    """Open the worktree folder in the OS file manager. Local tool only."""
    if not path or not os.path.isdir(path):
        return {"ok": False, "error": "bad_path"}
    try:
        if sys.platform == "darwin":
            subprocess.Popen(["open", path], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        else:
            subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
    except OSError as e:
        return {"ok": False, "error": str(e)}
    return {"ok": True}


def _running_banner(rows):
    """Show each running preview with its URL and Stop control."""
    items = []
    for row in rows:
        if not row.get("running"):
            continue
        path = html.escape(urllib.parse.quote(row["path"]), quote=True)
        items.append(
            f'<span class="live-item"><a class="live-link" href="http://localhost:{row["port"]}/" '
            f'target="_blank" rel="noopener">{html.escape(row["name"])}'
            f'<span class="live-port">:{row["port"]}</span></a>'
            f'<button class="btn stop" data-path="{path}">stop</button></span>'
        )
    if not items:
        return ""
    return ('<div class="live-bar"><span class="live-dot">●</span>'
            '<span class="live-label">serving now</span>' + ''.join(items) + '</div>')


def copy_payload(row):
    """The handoff block the copy button puts on the clipboard.

    Carries the worktree path, branch, project, PR, and issue: those
    are what make the paste actionable without a round of "which worktree?"
    questions. Lines are omitted rather than left blank so a detached or
    PR-less row pastes clean.
    """
    lines = [f"worktree: {row.get('name', '')}"]
    if row.get("project"):
        lines.append(f"project: {row['project']}")
    if row.get("branch"):
        lines.append(f"branch: {row['branch']}")
    if row.get("issue_id"):
        lines.append(f"issue: {row['issue_id']}")
    if row.get("pr_number") is not None:
        pr = f"pr: #{row['pr_number']}"
        if row.get("pr_label"):
            pr += f" ({row['pr_label']})"
        if row.get("pr_url"):
            pr += f" {row['pr_url']}"
        lines.append(pr)
    if row.get("path"):
        lines.append(f"path: {row['path']}")
    if row.get("running") and row.get("port"):
        lines.append(f"serving: http://localhost:{row['port']}/")
    return "\n".join(lines)


def _copy_button(row):
    # Newlines survive as &#10;: a raw \n in an attribute is legal but gets
    # normalised to a space by the parser, which would flatten the block.
    payload = html.escape(copy_payload(row), quote=True).replace("\n", "&#10;")
    return (f'<button class="btn copy" data-copy="{payload}" '
            f'title="Copy this card&#39;s details to paste into chat">copy</button>')


def _served_identity(row):
    """Visible proof of the exact worktree revision a live process serves."""
    revision = row.get("served_revision") or ""
    if not revision:
        return ""
    head = row.get("head") or ""
    stale = bool(head and revision != head)
    label = f"stale {revision[:8]} → {head[:8]}" if stale else f"served {revision[:8]}"
    title = f"Serving {row.get('path') or ''} at {revision}"
    return (f' <span class="{"crashed" if stale else "shared"}" '
            f'title="{html.escape(title, quote=True)}">{html.escape(label)}</span>')


def _row_html(row):
    path_q = html.escape(urllib.parse.quote(row["path"]), quote=True)
    linear = html.escape(row["issue_id"]) if row["issue_id"] else "—"
    branch = html.escape(row["branch"] or "(detached)")
    date = html.escape(row["commit_date"][:10] or "—")
    search = html.escape(_search_blob(row), quote=True)
    owner = html.escape(row.get("owner") or "", quote=True)
    project = html.escape(row.get("project") or row.get("repo") or "", quote=True)
    startable = row.get("startable", True)
    # Trailing controls every row carries, startable or not -- a worktree with
    # no dev server is still something to hand over with a comment attached.
    reveal = (f'{_copy_button(row)} '
              f'<button class="btn reveal" data-path="{path_q}" '
              f'title="Reveal in Finder">reveal</button>')

    if not startable:
        status = '<span class="no-dev">no dev server</span>'
        action = reveal
        row_class = " not-startable"
    elif row["running"]:
        # localhost, not 127.0.0.1: a plain `vite dev` (no --host) binds
        # IPv6 loopback only -- see preview.port_is_ready's same note.
        url = f"http://localhost:{row['port']}/"
        status = (f'<span class="running">● running :{row["port"]}</span>'
                  f'{_served_identity(row)}')
        action = (f'<a class="btn open" href="{html.escape(url)}" target="_blank">open</a> '
                 f'<button class="btn stop" data-path="{path_q}">stop</button> '
                 f'{reveal}')
        row_class = " is-running"
    elif row.get("crashed"):
        # Dead process (not intentional stop). Show log tail so the user sees the
        # process failure without hunting .preview/log (switchboard-9hz).
        port_bit = f" :{row['port']}" if row.get("port") else ""
        status = f'<span class="crashed">✕ crashed{html.escape(port_bit)}</span>'
        if row.get("message"):
            status += f'<div class="crash-msg">{html.escape(row["message"])}</div>'
        if row.get("log_tail"):
            status += f'<pre class="crash-log">{html.escape(row["log_tail"])}</pre>'
        label = "start"
        action = (f'<button class="btn start" data-path="{path_q}">{html.escape(label)}</button> '
                 f'{reveal}')
        row_class = " is-crashed"
    else:
        status = f'<span class="stopped">○ stopped</span>'
        label = "start"
        action = (f'<button class="btn start" data-path="{path_q}">{html.escape(label)}</button> '
                 f'{reveal}')
        row_class = ""

    if row.get("pr_number") is not None and row.get("pr_url"):
        pr_cell = (
            f'<a class="pr-link" href="{html.escape(row["pr_url"])}" '
            f'target="_blank" rel="noopener" title="{html.escape(row.get("pr_title") or "")}">'
            f'#{html.escape(str(row["pr_number"]))}</a>'
        )
        pill_class = {
            "Open": "open",
            "Merged": "merged",
            "Cancelled": "cancelled",
        }.get(row.get("pr_label") or "", "")
        state_cell = (
            f'<span class="pill {pill_class}">{html.escape(row["pr_label"])}</span>'
            if pill_class else "—"
        )
    else:
        pr_cell = "—"
        state_cell = "—"

    # Project cell: show Owner/repo when known, else bare repo basename.
    project_display = row.get("project") or row.get("repo") or ""
    project_cell = html.escape(project_display)

    return (f'<tr class="{row_class.strip()}" data-path="{path_q}" data-search="{search}"'
           f' data-owner="{owner}" data-project="{project}"'
           f' data-name="{html.escape(row["name"], quote=True)}"'
           f' data-startable="{"1" if startable else "0"}">'
           f'<td class="project" title="{project}">{project_cell}</td>'
           f'<td>{html.escape(row["name"])}</td>'
           f'<td class="branch">{branch}</td>'
           f'<td>{linear}</td>'
           f'<td class="pr">{pr_cell}</td>'
           f'<td class="pr-state">{state_cell}</td>'
           f'<td>{date}</td>'
           f'<td>{status}</td>'
           f'<td class="action">{action}</td>'
           f'</tr>')


