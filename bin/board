<script>
(function () {{
  const q = document.getElementById('q');
  const projectFilter = document.getElementById('project');
  const countEl = document.getElementById('count');
  const empty = document.getElementById('empty');
  const rows = () => Array.from(document.querySelectorAll('#rows tr'));

  function projectMatch(tr, sel) {{
    if (!sel || sel === 'all') return true;
    if (sel.indexOf('owner:') === 0) {{
      return (tr.getAttribute('data-owner') || '') === sel.slice(6);
    }}
    if (sel.indexOf('project:') === 0) {{
      return (tr.getAttribute('data-project') || '') === sel.slice(8);
    }}
    return true;
  }}

  function filter() {{
    const needle = (q.value || '').trim().toLowerCase();
    const sel = projectFilter.value || 'all';
    let visible = 0;
    for (const tr of rows()) {{
      const hay = tr.getAttribute('data-search') || '';
      const textOk = !needle || hay.indexOf(needle) !== -1;
      const projOk = projectMatch(tr, sel);
      const show = textOk && projOk;
      tr.classList.toggle('is-hidden', !show);
      if (show) visible++;
    }}
    countEl.textContent = String(visible);
    empty.classList.toggle('show', visible === 0);
  }}
  // Survive a reload: an auto-refresh that silently cleared the search box
  // would be worse than the staleness it fixes.
  try {{
    const savedQ = sessionStorage.getItem('board.q');
    const savedP = sessionStorage.getItem('board.project');
    if (savedQ) q.value = savedQ;
    if (savedP) projectFilter.value = savedP;
  }} catch (e) {{}}
  function remember() {{
    try {{
      sessionStorage.setItem('board.q', q.value || '');
      sessionStorage.setItem('board.project', projectFilter.value || 'all');
    }} catch (e) {{}}
  }}
  q.addEventListener('input', () => {{ remember(); filter(); }});
  projectFilter.addEventListener('change', () => {{ remember(); filter(); }});
  filter();
}})();

// One bounded request per action. The backend owns startup and cleanup.
window.__boardStarting = false;
async function request(url, options = {{}}, timeout = 5000) {{
  const response = await fetch(url, {{...options, signal: AbortSignal.timeout(timeout)}});
  if (!response.ok) throw new Error('The board could not finish this request. Try again.');
  return response.json();
}}
(function () {{
  const MINE = "{fingerprint}";
  let checking = false;
  async function check() {{
    if (checking || window.__boardStarting || document.hidden) return;
    checking = true;
    try {{
      const data = await request('/api/fingerprint');
      if (!window.__boardStarting && data.fingerprint !== MINE) location.reload();
    }} catch (error) {{ /* Retry after a board restart. */ }}
    finally {{ checking = false; }}
  }}
  document.addEventListener('visibilitychange', check);
  setInterval(check, 500);
}})();
window.addEventListener('pageshow', e => {{ if (e.persisted) location.reload(); }});

document.addEventListener('click', async e => {{
  const btn = e.target.closest('button.btn');
  if (!btn) return;
  const path = btn.dataset.path;
  if (btn.classList.contains('start') || btn.classList.contains('stop')) {{
    if (window.__boardStarting) return;
    const starting = btn.classList.contains('start');
    const label = btn.textContent;
    const tab = starting ? window.open('/starting?name=' + encodeURIComponent(btn.closest('tr')?.dataset.name || ''), '_blank') : null;
    window.__boardStarting = true;
    btn.disabled = true;
    btn.textContent = starting ? 'preparing and starting…' : 'stopping…';
    try {{
      const action = starting ? 'start' : 'stop';
      const data = await request('/api/' + action + '?path=' + path, {{method: 'POST'}}, 780000);
      if (!data.ok) throw new Error([data.message || data.error || 'The action failed.', data.log_tail || ''].filter(Boolean).join('\\n'));
      if (starting) {{
        const land = 'http://localhost:' + data.port + '/';
        if (tab && !tab.closed) tab.location = land; else window.open(land, '_blank');
      }}
      location.reload();
    }} catch (error) {{
      if (tab && !tab.closed) tab.close();
      btn.textContent = starting ? 'could not start — retry' : 'could not stop — retry';
      btn.title = error.message;
      btn.closest('td')?.querySelector('details')?.remove();
      const detail = document.createElement('details');
      const summary = document.createElement('summary');
      summary.textContent = 'Show details';
      const explanation = document.createElement('p');
      explanation.textContent = error.message;
      detail.append(summary, explanation);
      btn.closest('td')?.append(detail);
      setTimeout(() => {{ btn.textContent = label; }}, 5000);
    }} finally {{
      window.__boardStarting = false;
      btn.disabled = false;
    }}
  }} else if (btn.classList.contains('copy')) {{
    const label = btn.textContent;
    try {{
      await navigator.clipboard.writeText(btn.dataset.copy || '');
      btn.textContent = 'copied';
    }} catch (error) {{ btn.textContent = 'copy failed'; }}
    btn.classList.add('copied');
    setTimeout(() => {{ btn.textContent = label; btn.classList.remove('copied'); }}, 1200);
  }} else if (btn.classList.contains('reveal')) {{
    btn.disabled = true;
    try {{ await request('/api/reveal?path=' + path, {{method: 'POST'}}); }}
    catch (error) {{ btn.textContent = 'reveal failed'; }}
    finally {{ btn.disabled = false; }}
  }}
}});
</script>
</body></html>
"""


def render_starting_page(name):
    """The waiting screen the popup shows while a dev server boots."""
    return STARTING_PAGE.replace("__NAME__", html.escape(name or "worktree"))


def render_page():
    current_fingerprint = fingerprint()
    rows = build_rows()
    return PAGE.format(
        count=len(rows),
        rows="\n".join(_row_html(r) for r in rows),
        project_options=_project_options_html(rows),
        running_banner=_running_banner(rows),
        fingerprint=current_fingerprint,
    )


class Handler(http.server.BaseHTTPRequestHandler):
    def _local_request(self):
        hosts = {f'localhost:{PORT}', f'127.0.0.1:{PORT}'}
        origin = self.headers.get('Origin')
        if self.headers.get('Host') not in hosts or (origin and origin not in {f'http://{host}' for host in hosts}):
            self.send_error(403)
            return False
        return True

    def _send(self, body, status=200, content_type="text/html; charset=utf-8"):
        b = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(b)))
        # Every response here is live state (what is running, on which port).
        # Without this the browser happily re-serves a cached board showing a
        # server as stopped that you started minutes ago.
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(b)

    def _json(self, obj):
        self._send(json.dumps(obj), content_type="application/json")

    def _query(self):
        parsed = urllib.parse.urlparse(self.path)
        return parsed.path, urllib.parse.parse_qs(parsed.query)

    def _send_bytes(self, data, content_type):
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if not self._local_request():
            return
        path, qs = self._query()
        if path == "/":
            self._send(render_page())
        elif path == "/starting":
            self._send(render_starting_page(qs.get("name", [""])[0]))
        elif path == "/avatar.png":
            try:
                with open(AVATAR_PATH, "rb") as f:
                    self._send_bytes(f.read(), "image/png")
            except OSError:
                self.send_error(404)
        elif path == "/health":
            self._json(merged_pr_cleanup.health())
        elif path == "/api/fingerprint":
            self._json({"fingerprint": fingerprint()})
        elif path == "/api/ready":
            port = int(qs.get("port", ["0"])[0])
            self._json({"ready": bool(port) and preview.port_is_ready(port)})
        else:
            self.send_error(404)

    def do_POST(self):
        if not self._local_request():
            return
        try:
            self._post()
        except Exception as error:
            self._json({'ok': False, 'error': 'request_failed', 'message': str(error)})

    def _post(self):
        path, qs = self._query()
        wt = qs.get("path", [""])[0]
        if path == "/api/start":
            self._json(preview.start(wt))
        elif path == "/api/stop":
            self._json(preview.stop(wt))
        elif path == "/api/reveal":
            self._json(_reveal_path(wt))
        else:
            self.send_error(404)

    def log_message(self, fmt, *args):
        pass  # ponytail: a personal local tool doesn't need request-log noise


URL = f"http://127.0.0.1:{PORT}"
BOARD_LOG = os.path.expanduser("~/.local/state/worktree-preview-board/board.log")


def already_serving():
    """True when a board is already answering on PORT.

    Starting a second one only crashes on bind, and 'it is already up, here is
    the link' is the honest answer to someone who just wants the board open.
    """
    try:
        with socket.create_connection(("127.0.0.1", PORT), timeout=0.3):
            return True
    except OSError:
        return False


def start_background(wait_s=15.0):
    """Launch a detached board and return once it actually answers.

    start_new_session so it outlives the shell (or agent) that asked for it.
    Returns True if the board is serving by the time we give up waiting.
    """
    os.makedirs(os.path.dirname(BOARD_LOG), exist_ok=True)
    log = open(BOARD_LOG, "ab")
    subprocess.Popen(
        [sys.executable, os.path.realpath(__file__)],
        stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.time() + wait_s
    while time.time() < deadline:
        if already_serving():
            return True
        time.sleep(0.25)
    return False


def main():
    ap = argparse.ArgumentParser(prog="board", description=__doc__)
    ap.add_argument("--background", action="store_true",
                    help="start detached, print the URL, and exit")
    args = ap.parse_args()

    if already_serving():
        print(f"{URL}  (already running)")
        return
    if args.background:
        if start_background():
            print(URL)
            return
        print(f"board did not come up within 15s; see {BOARD_LOG}", file=sys.stderr)
        sys.exit(1)

    merged_pr_cleanup.start(preview)
    threading.Thread(target=_revision_watcher, daemon=True,
                     name="board-revision-watcher").start()
    server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print(URL)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
